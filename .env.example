# Runtime database (Transaction Pooler, port 6543)
DATABASE_URL=

# Drizzle migrate / seed (Session Pooler, port 5432)
MIGRATE_URL=

# OpenAI API key for AI answers
OPENAI_API_KEY=

# Supabase Auth (public — safe for browser bundle)
# Get from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Note: Google OAuth Client ID / Client Secret are NOT stored here.
# Enter them in Supabase Dashboard → Authentication → Providers → Google.
#
# Supabase Dashboard → Authentication → URL Configuration:
# - Site URL: https://project-garage-lyart.vercel.app
# - Redirect URLs (add all that apply):
#     http://localhost:5173/auth/callback
#     https://project-garage-lyart.vercel.app/auth/callback
#     https://*.vercel.app/auth/callback
#
# Preview deployments use the browser origin for OAuth redirectTo.
# The wildcard Vercel redirect URL is required so Supabase accepts Preview callbacks.
#
# Optional comma-separated extra allowed auth origins (custom domains):
# AUTH_ALLOWED_ORIGINS=https://your-custom-domain.example

# Comma-separated Google account emails allowed to use /admin/product-import
PRODUCT_IMPORT_ADMIN_EMAILS=
