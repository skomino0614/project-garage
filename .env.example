# Runtime database (Transaction Pooler, port 6543)
DATABASE_URL=

# Drizzle migrate / seed (Session Pooler, port 5432)
MIGRATE_URL=

# OpenAI API key for AI answers
OPENAI_API_KEY=

# Supabase Auth (public — safe for browser bundle)
# Get from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Note: Google OAuth Client ID / Client Secret are NOT stored here.
# Enter them in Supabase Dashboard → Authentication → Providers → Google.
# Add http://localhost:5173/auth/callback to Supabase → Authentication → URL Configuration → Redirect URLs.

# Comma-separated Google account emails allowed to use /admin/product-import
PRODUCT_IMPORT_ADMIN_EMAILS=
